# Track only application source and explicitly approved reference files.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/main.py
!/requirements.txt
!/ALL weapons.txt
!/Untitled.txt
!/relicframe/
!/csharp/
!/csharp/run-bot.sh

/csharp/**/bin/
/csharp/**/obj/
/csharp/**/publish/
/csharp/fixtures.generated.json
/csharp/runtime/
/csharp/.audit-bot/
/csharp/.audit-tests/
/.dotnet_cli/
/.nuget/

/relicframe/*
!/relicframe/*.py
!/relicframe/*.bat
!/relicframe/requirements.txt
!/relicframe/README.md
!/relicframe/.env.example
!/relicframe/docs/
!/relicframe/tests/
/relicframe/tests/*
!/relicframe/tests/*.py
!/relicframe/data/
/relicframe/data/*
!/relicframe/data/relics_from_official_data.csv
!/relicframe/data/rivens/
/relicframe/data/rivens/*
!/relicframe/data/rivens/attributes.json
!/relicframe/data/rivens/roll_rules.json
!/relicframe/data/rivens/weapon_variants.json
!/relicframe/data/rivens/weapons.json

# Never commit secrets, runtime state, or local development environments.
**/.env
**/.env.*
!relicframe/.env.example
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]
**/.cache/
**/.idea/
**/*.log
**/*.pem
**/*.key
**/discord_world_state.json
**/discord_list_state.json
**/trade_chat_offers.jsonl
**/seller_blacklist.json
**/companion_sales/
**/companion_current_market/
**/rivens/history/
**/rivens/latest.json
**/rivens/flip_index.json
